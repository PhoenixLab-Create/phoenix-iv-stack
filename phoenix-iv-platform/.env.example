# Copy to .env for local development. NEVER commit a real .env.
# NEVER put real patient data in any non-production environment.

NODE_ENV=development
PORT=3000

# Local dev Postgres (docker-compose) — production uses Azure Database for
# PostgreSQL Flexible Server (Canada Central), connection string injected via
# Azure Key Vault / managed identity, never committed here.
DATABASE_URL="postgresql://phoenix:phoenix_dev_only@localhost:5432/phoenix_iv_dev?schema=public"

# JWT — generate a real random 256-bit secret locally; production secret lives in Key Vault.
JWT_ACCESS_SECRET="dev-only-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-only-change-me-too"
JWT_REFRESH_TTL="12h"

# Session / idle timeout policy (seconds) — matches architecture doc defaults.
STAFF_IDLE_TIMEOUT_SECONDS=900
PATIENT_IDLE_TIMEOUT_SECONDS=300

# MFA (TOTP) — issuer name shown in authenticator apps.
MFA_ISSUER="Phoenix Medical Aesthetics (DEV)"
